# ── App ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database — single unified DB ─────────────────────────
DATABASE_URL=
# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# ── Internal service-to-service auth ─────────────────────
# Shared with API Gateway and any other service calling /internal/*
INTERNAL_SECRET=change_me_to_a_random_internal_secret

# ── OTP ───────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
